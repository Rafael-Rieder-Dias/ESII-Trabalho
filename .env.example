# Copie para .env:  cp .env.example .env   (no Windows: copy .env.example .env)

# --- Moodle ---------------------------------------------------------------
# Padrão: Moodle simulado que sobe junto no docker compose.
# Para um Moodle real, troque pela URL da instalação e um token de webservice
# com as funções mod_assign_get_assignments, core_enrol_get_enrolled_users e
# mod_assign_get_submissions liberadas.
MOODLE_URL=http://moodle-mock:8000
MOODLE_URL_PUBLICA=http://localhost:8000
MOODLE_TOKEN=token-demo
MOODLE_CURSO_ID=101

# --- Acompanhamento ------------------------------------------------------
# Produção: 3600 (a cada hora). Demonstração: 30.
INTERVALO_SEGUNDOS=30
JANELA_HORAS=24

# --- Notificações --------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORTA=1025
SMTP_REMETENTE=Reengajamento Moodle <nao-responda@reengajamento.local>
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=false
FUSO_HORARIO=America/Sao_Paulo
MAX_TENTATIVAS=5
ATRASO_RETENTATIVA_SEGUNDOS=15
# Permite POST /admin/limpar no Notificações (usado pelo script de verificação).
# Deixe false fora da demonstração.
PERMITIR_LIMPEZA=true

# --- Filas (mesmos nomes nos dois serviços) ------------------------------
FILA_SOLICITACOES=reengajamento.solicitacoes
FILA_RETENTATIVAS=reengajamento.retentativas
FILA_FALHAS=reengajamento.falhas
